new file mode 100644
index 0000000..d0e9236
--- /dev/null
+++ b/win/gui_launcher/main.go
@@ -0,0 +1,146 @@
+// Build-IPA-GUI.exe: a native Windows launcher for the builder window (win/gui.pyw).
+// Same job as Build-IPA-GUI.bat: find Python's pythonw.exe and start the window with it.
+// Differences from the .bat: no "pythonw is not recognized" console flash — a message box
+// explains what to install, and Python installs that never made it onto PATH are found in
+// their default folders. The pipeline itself is untouched: the window still runs
+// win/build_ipa_windows.py with the same python.exe (gui.pyw's console_python()).
+//
+// Build (cross-compiles from Linux, runs on Windows 10/11 x64):
+//
+//	CGO_ENABLED=0 GOOS=windows GOARCH=amd64 go build -ldflags="-s -w -H=windowsgui" -o Build-IPA-GUI.exe .
+//
+// An optional icon: put a rsrc_windows_amd64.syso beside main.go before the build
+//
+//	(rsrc -ico icon.ico -o rsrc_windows_amd64.syso).
+package main
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+func main() {
+	// The exe belongs in the repository root, next to Build-IPA-GUI.bat.
+	exe, err := os.Executable()
+	if err != nil {
+		exe = os.Args[0]
+	}
+	repo := filepath.Dir(exe)
+	script := filepath.Join(repo, "win", "gui.pyw")
+	if _, err := os.Stat(script); err != nil {
+		box("Build-IPA-GUI.exe must stay in the repository root, the folder that contains win\\.\n" +
+			"Keep it next to Build-IPA-GUI.bat.")
+		os.Exit(1)
+	}
+
+	pythonw, ok := findPythonw()
+	if !ok {
+		box("Python was not found.\n\n" +
+			"Install it from https://www.python.org/downloads/ (3.10 or later) and\n" +
+			"check \"Add python.exe to PATH\" in the installer's first page.\n\n" +
+			"Already installed? Set the NXW_PYTHONW environment variable to the full\n" +
+			"path of pythonw.exe, or put its folder on PATH.")
+		os.Exit(1)
+	}
+
+	cmd := exec.Command(pythonw, script)
+	cmd.Dir = repo
+	if err := cmd.Start(); err != nil {
+		box("Could not start the builder window with:\n" + pythonw + "\n\n" + err.Error())
+		os.Exit(1)
+	}
+	// Detached like the .bat's `start`: the launcher exits, the window stays.
+	os.Exit(0)
+}
+
+// findPythonw returns the best pythonw.exe: the NXW_PYTHONW override, PATH
+// (what `where pythonw` finds, as the .bat), the newest default-folder install,
+// then the py launcher's Python.
+func findPythonw() (string, bool) {
+	if p := os.Getenv("NXW_PYTHONW"); p != "" {
+		if isFile(p) {
+			return p, true
+		}
+	}
+	if p, err := exec.LookPath("pythonw.exe"); err == nil {
+		return p, true
+	}
+	if p := newestDefaultInstall(); p != "" {
+		return p, true
+	}
+	if p := fromPyLauncher(); p != "" {
+		return p, true
+	}
+	return "", false
+}
+
+// newestDefaultInstall picks the highest-version pythonw.exe from Python's
+// default install folders (per-user under LOCALAPPDATA, machine-wide under
+// Program Files). Nothing here needs the registry.
+func newestDefaultInstall() string {
+	local := os.Getenv("LOCALAPPDATA")
+	patterns := []string{
+		filepath.Join(local, "Programs", "Python", "Python3*", "pythonw.exe"),
+		`C:\Program Files\Python3*\pythonw.exe`,
+		`C:\Program Files (x86)\Python3*\pythonw.exe`,
+	}
+	var found []string
+	for _, pat := range patterns {
+		if matches, _ := filepath.Glob(pat); matches != nil {
+			found = append(found, matches...)
+		}
+	}
+	if len(found) == 0 {
+		return ""
+	}
+	sort.Slice(found, func(i, j int) bool { return versionOf(found[i]) > versionOf(found[j]) })
+	return found[0]
+}
+
+// versionOf sorts Python3XX / Python3XX-32 / Python3XX-ARM folder names newest
+// first. Only the digits of the version number count: a "-32" or "-arm64"
+// suffix must not turn 3.12's folder into "31232" and beat 3.13's "313".
+func versionOf(p string) int {
+	v := 0
+	for _, part := range strings.Split(strings.ReplaceAll(p, `\`, "/"), "/") {
+		if !strings.HasPrefix(part, "Python3") {
+			continue
+		}
+		rest := strings.TrimPrefix(part, "Python")
+		end := 0
+		for end < len(rest) && rest[end] >= '0' && rest[end] <= '9' {
+			end++
+		}
+		if n, err := strconv.Atoi(rest[:end]); err == nil && n > v {
+			v = n
+		}
+	}
+	return v
+}
+
+// fromPyLauncher asks the installed py launcher where its Python 3 lives and
+// returns the pythonw.exe beside it.
+func fromPyLauncher() string {
+	py, err := exec.LookPath("py.exe")
+	if err != nil {
+		return ""
+	}
+	out, err := exec.Command(py, "-3", "-c", "import os,sys;print(os.path.join(sys.prefix,'pythonw.exe'))").Output()
+	if err != nil {
+		return ""
+	}
+	p := strings.TrimSpace(string(out))
+	if isFile(p) {
+		return p
+	}
+	return ""
+}
+
+func isFile(p string) bool {
+	info, err := os.Stat(p)
+	return err == nil && !info.IsDir()
+}
