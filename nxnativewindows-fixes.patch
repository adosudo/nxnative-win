@@ -0,0 +1,72 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"runtime"
+	"testing"
+)
+
+func TestVersionOf(t *testing.T) {
+	cases := map[string]int{
+		`C:\Program Files\Python313\pythonw.exe`:                               313,
+		`C:\Program Files\Python310\pythonw.exe`:                               310,
+		`C:\Users\x\AppData\Local\Programs\Python\Python312-32\pythonw.exe`:    312,
+		`C:\Users\x\AppData\Local\Programs\Python\Python314-arm64\pythonw.exe`: 314,
+		`C:\not\python\pythonw.exe`:                                            0,
+	}
+	for path, want := range cases {
+		if got := versionOf(path); got != want {
+			t.Errorf("versionOf(%q) = %d, want %d", path, got, want)
+		}
+	}
+}
+
+// newestDefaultInstall is only checked through the LOCALAPPDATA pattern: the
+// Program Files patterns would read a real machine's installs on Windows.
+func TestNewestDefaultInstall(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("the Program Files patterns would read this machine's real installs")
+	}
+	local := t.TempDir()
+	t.Setenv("LOCALAPPDATA", local)
+	for _, v := range []string{"Python310", "Python313", "Python312"} {
+		dir := filepath.Join(local, "Programs", "Python", v)
+		if err := os.MkdirAll(dir, 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(dir, "pythonw.exe"), []byte("x"), 0o755); err != nil {
+			t.Fatal(err)
+		}
+	}
+	got := newestDefaultInstall()
+	if want := filepath.Join(local, "Programs", "Python", "Python313", "pythonw.exe"); got != want {
+		t.Errorf("newestDefaultInstall() = %q, want %q", got, want)
+	}
+}
+
+func TestFindPythonwEnvBeatsPath(t *testing.T) {
+	dir := t.TempDir()
+	onPath := filepath.Join(dir, "pythonw.exe")
+	if err := os.WriteFile(onPath, []byte("x"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	override := filepath.Join(dir, "override", "pythonw.exe")
+	if err := os.MkdirAll(filepath.Dir(override), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(override, []byte("x"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+
+	t.Setenv("PATH", dir+string(os.PathListSeparator)+os.Getenv("PATH"))
+	t.Setenv("NXW_PYTHONW", "")
+	if got, ok := findPythonw(); !ok || got != onPath {
+		t.Errorf("with PATH only: findPythonw() = %q, %v; want %q, true", got, ok, onPath)
+	}
+
+	t.Setenv("NXW_PYTHONW", override)
+	if got, ok := findPythonw(); !ok || got != override {
+		t.Errorf("with override: findPythonw() = %q, %v; want %q, true", got, ok, override)
+	}
+}
