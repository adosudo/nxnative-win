--- /dev/null
+++ b/win/gui_launcher/box_windows.go
@@ -0,0 +1,20 @@
+//go:build windows
+
+// The message box lives in a Windows-only file: user32's MessageBoxW, reached
+// through syscall, so the launcher needs no module dependencies. Errors reach a
+// double-clicking user even though the exe has no console (windowsgui).
+package main
+
+import (
+	"syscall"
+	"unsafe"
+)
+
+func box(text string) {
+	user32 := syscall.NewLazyDLL("user32.dll")
+	mbox := user32.NewProc("MessageBoxW")
+	title, _ := syscall.UTF16PtrFromString("NXNative for Windows")
+	body, _ := syscall.UTF16PtrFromString(text)
+	// 0 = MB_OK, 0x10 = MB_ICONERROR
+	mbox.Call(0, uintptr(unsafe.Pointer(body)), uintptr(unsafe.Pointer(title)), 0x10)
+}
